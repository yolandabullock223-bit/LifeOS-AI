# LifeOS AI - Environment Configuration

# Application
APP_NAME=LifeOS-AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lifeos_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CACHE_TTL=3600

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM Provider
LLM_PROVIDER=openai  # openai, anthropic, cohere, local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# Vector Database
VECTOR_DB_TYPE=pinecone  # pinecone, weaviate, milvus, local
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=lifeos-knowledge

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@lifeos-ai.com

# Storage
STORAGE_TYPE=s3  # s3, gcs, local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=lifeos-ai-bucket
AWS_REGION=us-east-1

# Payment
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=

# Analytics
ANALYTICS_ENABLED=True
SEGMENT_WRITE_KEY=
AMPLITUDE_API_KEY=

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=True
TRACE_ENABLED=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Features
ENABLE_AI_COACHING=True
ENABLE_AVATAR=True
ENABLE_WORLD_PROGRESSION=True
ENABLE_MONETIZATION=False
ENABLE_NOTIFICATIONS=True

# Safety
HALLUCINATION_DETECTION_ENABLED=True
PROMPT_INJECTION_DETECTION_ENABLED=True
CONTENT_MODERATION_ENABLED=True
FACT_CHECK_ENABLED=True

# Accessibility
WCAG_COMPLIANCE_LEVEL=AA
SCREEN_READER_SUPPORT=True
REDUCED_MOTION_SUPPORT=True

# Development
MOCK_LLM=False
MOCK_PAYMENTS=True
SEED_DATABASE=False
ALLOW_TEST_ENDPOINTS=True
